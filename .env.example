# NecroMARC configuration template.
# Copy to .env and fill in real values. Never commit .env.

# --- Supabase (required) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- OpenRouter (required) ---
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=provider/model-name
# Comma separated, may be empty.
OPENROUTER_FALLBACK_MODELS=

# --- Gemini embeddings (required) ---
GEMINI_API_KEY=your-gemini-api-key
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- Judge login (required) ---
JUDGE_USERNAME=your-judge-username
# At least 16 characters, different from JUDGE_USERNAME.
JUDGE_PASSWORD=change-me-to-a-long-password
# At least 32 characters.
JWT_SECRET_KEY=change-me-to-a-random-string-of-32-or-more-characters

# --- HTTP ---
# Comma separated absolute origins. "*" is rejected.
CORS_ORIGINS=https://your-domain.example

# --- Frontend build only ---
PUBLIC_BASE_PATH=/
PUBLIC_API_URL=https://your-domain.example/api
# PUBLIC_RESURRECT_TIMEOUT_MS=120000

# --- Optional tuning (defaults shown; uncomment to override) ---
# JUDGE_TOKEN_TTL_SECONDS=3600
# MAX_UPLOAD_BYTES=5242880
# DEFAULT_PAGE_SIZE=20
# MAX_PAGE_SIZE=50
# RATE_LIMIT_REQUESTS=30
# RATE_LIMIT_WINDOW_SECONDS=60
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_WINDOW_SECONDS=60
# SIMILARITY_THRESHOLD=0.75
# SEMANTIC_EDGE_MAX=1000

# --- Seed script only (optional) ---
# SEED_WAIT_SECONDS=
# SEED_QUOTA_GUTENBERG=
# SEED_QUOTA_LOC=
# SEED_QUOTA_SYNTHETIC=
# SYNTHETIC_SEED=
# GUTENBERG_MARC_URL_TEMPLATE=
# LOC_SRU_URL=
