<button
  type="button"
  id="language-toggle"
  class="btn ms-2 px-3 py-1"
  data-i18n="lang.toggle"
  data-i18n-attr="aria-label:lang.toggle.label"
  aria-label="Switch language to Arabic"
>العربية</button>
<script>
  import { initI18n, setLang, getLang } from '../i18n/i18n';
  initI18n();
  document.getElementById('language-toggle')?.addEventListener('click', () => {
    setLang(getLang() === 'en' ? 'ar' : 'en');
  });
</script>
