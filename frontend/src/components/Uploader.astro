---
---
<section id="uploader" class="surface-1 p-4 grid gap-4 min-w-0" aria-labelledby="up-title">
  <h2 id="up-title" class="font-serif text-xl text-gold" data-i18n="summon.upload.title">Upload a .mrc file</h2>

  <div id="up-guest" class="flex flex-wrap items-center gap-3" hidden>
    <span data-i18n="summon.guest">Uploading and resurrecting are available to judges.</span>
    <button type="button" id="up-login" class="btn" data-i18n="nav.login">Judge login</button>
  </div>

  <div id="up-judge" class="grid gap-3" hidden>
    <div id="up-drop" class="p-6 text-center grid gap-2 justify-items-center">
      <p data-i18n="summon.upload.drop">Drop a .mrc file here</p>
      <input type="file" id="up-file" accept=".mrc" class="sr-only" tabindex="-1" aria-hidden="true" />
      <button type="button" id="up-choose" class="btn" data-i18n="summon.upload.button">Choose file</button>
    </div>
  </div>

  <div class="flex flex-wrap items-center gap-3">
    <button type="button" id="up-tomb" class="btn" data-i18n="summon.tomb.button">Summon &amp; Resurrect Sample Tomb</button>
  </div>
  <p id="up-tomb-remaining" role="status" aria-live="polite" hidden class="font-mono text-xs"></p>
  <div id="up-tomb-exhausted" role="status" hidden class="grid gap-2">
    <p class="font-serif text-gold" data-i18n="summon.tomb.exhausted_title">Every sample has been resurrected</p>
    <p id="up-tomb-exhausted-text"></p>
    <p class="flex flex-wrap gap-3">
      <a id="up-tomb-archive" href="/" class="text-gold underline" data-i18n="summon.tomb.archive_link">Browse the resurrected archive</a>
      <a id="up-tomb-sources" href="#marc-sources" class="text-gold underline" data-i18n="summon.tomb.sources_link">Get a MARC file to upload</a>
    </p>
  </div>
  <div id="up-tomb-guest" class="flex flex-wrap items-center gap-3" hidden>
    <span data-i18n="summon.guest">Uploading and resurrecting are available to judges.</span>
    <button type="button" id="up-login2" class="btn" data-i18n="nav.login">Judge login</button>
  </div>

  <p id="up-error" role="alert" hidden class="font-mono text-xs text-decay-red"></p>
  <p id="up-status" role="status" aria-live="polite" hidden class="font-mono text-xs text-phosphor"></p>

  <div id="up-results" hidden class="grid gap-2">
    <h3 class="font-serif text-lg text-gold" data-i18n="summon.results.title">Parsed records</h3>
    <p id="up-parsed-count"></p>
    <p id="up-parse-errors" hidden class="font-mono text-xs text-decay-red"></p>
    <p id="up-limit" class="text-sm" data-i18n="summon.results.limit">Files up to 5 MB can be loaded. Select at most 5 records at a time.</p>
    <div class="flex flex-wrap items-center gap-2">
      <input type="search" id="up-search" dir="auto" class="field min-w-0 flex-1" data-i18n-attr="aria-label:summon.results.search" />
      <button type="button" id="up-sort" class="btn"></button>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <span id="up-counter" role="status" aria-live="polite"></span>
      <button type="button" id="up-top" class="btn" data-i18n="summon.results.select_top">Select 5 most decayed</button>
      <button type="button" id="up-clear" class="btn" data-i18n="summon.results.clear">Clear selection</button>
    </div>
    <p id="up-why" role="alert" hidden class="font-mono text-xs text-decay-red"></p>
    <ul id="up-list" class="list-none ps-0 grid gap-2"></ul>
    <p id="up-empty" hidden class="text-sm"></p>
    <nav id="up-pager" class="flex flex-wrap items-center gap-3">
      <button type="button" id="up-prev" class="btn"></button>
      <span id="up-page" role="status" aria-live="polite"></span>
      <button type="button" id="up-next" class="btn"></button>
    </nav>
    <div>
      <button type="button" id="up-summon-all" class="btn" data-i18n="summon.results.summon_all">Summon selected (up to 5)</button>
    </div>
  </div>

  <div id="up-outcome" hidden class="grid gap-2">
    <p id="up-summary" role="status" class="font-mono text-xs"></p>
    <ul id="up-outcome-list" class="list-none ps-0 grid gap-1"></ul>
  </div>
</section>
<script>
  import { getTomb, resurrect, uploadMrc } from '../lib/api';
  import type { ParsedItem, RawRecord, ResurrectResponse, ResurrectSource, TombResponse } from '../lib/api';
  import { isJudge } from '../lib/auth';
  import { t } from '../i18n/i18n';
  import { appendLine, showFailure, showSuccess } from '../lib/terminal';
  import { MAX_BATCH_RECORDS, batchFailedBody, outcomeKey, summonErrorView, validateUpload } from '../lib/upload';
  import { filterItems, paginate, selectTopDecay, sortItems, toggleSelection } from '../lib/selection';
  import type { SortMode } from '../lib/selection';

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
  const guest = $('up-guest');
  const judgeBox = $('up-judge');
  const drop = $('up-drop');
  const fileInput = $<HTMLInputElement>('up-file');
  const chooseBtn = $<HTMLButtonElement>('up-choose');
  const tombBtn = $<HTMLButtonElement>('up-tomb');
  const tombGuest = $('up-tomb-guest');
  const errorEl = $('up-error');
  const statusEl = $('up-status');
  const resultsBox = $('up-results');
  const parseErrors = $('up-parse-errors');
  const parsedCount = $('up-parsed-count');
  const searchEl = $<HTMLInputElement>('up-search');
  const sortBtn = $<HTMLButtonElement>('up-sort');
  const counterEl = $('up-counter');
  const topBtn = $<HTMLButtonElement>('up-top');
  const clearBtn = $<HTMLButtonElement>('up-clear');
  const whyEl = $('up-why');
  const emptyEl = $('up-empty');
  const prevBtn = $<HTMLButtonElement>('up-prev');
  const nextBtn = $<HTMLButtonElement>('up-next');
  const pageEl = $('up-page');
  const list = $('up-list');
  const summonAll = $<HTMLButtonElement>('up-summon-all');
  const outcome = $('up-outcome');
  const summaryEl = $('up-summary');
  const outcomeList = $('up-outcome-list');
  const log = document.querySelector<HTMLElement>('[data-terminal-log]') as HTMLElement;
  const tombRemaining = $('up-tomb-remaining');
  const tombExhausted = $('up-tomb-exhausted');
  const tombExhaustedText = $('up-tomb-exhausted-text');
  $<HTMLAnchorElement>('up-tomb-archive').href = `${base}/`;

  let items: ParsedItem[] = [];
  let parseErrorCount = 0;
  const PAGE_SIZE = 20;
  let selected = new Set<number>();
  let query = '';
  let sortMode: SortMode = 'original';
  let page = 1;
  let whyShown = false;
  let busy = false;
  let errorState: { key: string; params?: Record<string, number> } | null = null;
  let statusKey: string | null = null;
  let last: ResurrectResponse | null = null;
  let tomb: { total: number; remaining: number; exhausted: boolean } | null = null;

  /** Pool status line, or the exhaustion message (Requirement 20.8). An older backend sends no pool fields. */
  function renderTomb() {
    tombRemaining.hidden = tomb === null || tomb.exhausted;
    tombExhausted.hidden = tomb === null || !tomb.exhausted;
    if (!tomb) return;
    tombRemaining.textContent = t('summon.tomb.remaining', { remaining: tomb.remaining, total: tomb.total });
    tombExhaustedText.textContent = t('summon.tomb.exhausted', { total: tomb.total });
  }

  function setTomb(res: TombResponse) {
    tomb = typeof res.total === 'number' && typeof res.remaining === 'number'
      ? { total: res.total, remaining: res.remaining, exhausted: res.exhausted === true || res.remaining === 0 }
      : null;
    renderTomb();
  }

  function failureText(index: number, code: string): string {
    return t('summon.log.fail_reason', { index: index + 1, reason: t(outcomeKey(code)) });
  }

  function logResults(res: ResurrectResponse) {
    for (const r of res.results) {
      if (r.status === 'success') appendLine(log, t('summon.log.ok', { index: r.index + 1 }), 'success');
      else appendLine(log, failureText(r.index, r.error.code), 'failure');
    }
  }

  function setError(e: { key: string; params?: Record<string, number> } | null) {
    errorState = e;
    errorEl.hidden = e === null;
    errorEl.textContent = e ? t(e.key, e.params) : '';
  }
  function setStatus(key: string | null) {
    statusKey = key;
    statusEl.hidden = key === null;
    statusEl.textContent = key ? t(key) : '';
  }

  function syncAuth() {
    const judge = isJudge();
    guest.hidden = judge;
    judgeBox.hidden = !judge;
    tombBtn.disabled = !judge || busy;
    tombGuest.hidden = judge;
    summonAll.disabled = busy;
    if (!judge) {
      items = [];
      selected = new Set();
      whyShown = false;
      renderItems();
    }
  }

  function selectedItems(): ParsedItem[] {
    return [...selected]
      .sort((x, y) => x - y)
      .map((i) => items[i])
      .filter(Boolean);
  }

  function setWhy(show: boolean) {
    whyShown = show;
    whyEl.hidden = !show;
    whyEl.textContent = show ? t('summon.results.why_limit') : '';
  }

  function renderItems() {
    list.replaceChildren();
    resultsBox.hidden = items.length === 0 && parseErrorCount === 0;
    parsedCount.textContent = t('summon.results.parsed_count', { count: items.length });
    parseErrors.hidden = parseErrorCount === 0;
    parseErrors.textContent = t('summon.results.parse_errors', { count: parseErrorCount });
    summonAll.hidden = items.length === 0;
    searchEl.placeholder = t('summon.results.search');
    sortBtn.textContent = t(sortMode === 'original' ? 'summon.results.sort_original' : 'summon.results.sort_decay');
    counterEl.textContent = t('summon.results.selected', { n: selected.size, max: MAX_BATCH_RECORDS });
    setWhy(whyShown);
    const entries = items.map((it, i) => ({ it, i, title: it.title, control_number: it.control_number, decay: it.decay }));
    const view = sortItems(filterItems(entries, query), sortMode);
    const pages = Math.max(1, Math.ceil(view.length / PAGE_SIZE));
    page = Math.min(Math.max(1, page), pages);
    pageEl.textContent = t('summon.results.page', { page, pages });
    prevBtn.textContent = t('summon.results.prev');
    nextBtn.textContent = t('summon.results.next');
    prevBtn.disabled = page <= 1;
    nextBtn.disabled = page >= pages;
    emptyEl.hidden = !(items.length > 0 && view.length === 0);
    emptyEl.textContent = emptyEl.hidden ? '' : t('summon.results.no_matches');
    for (const { it, i } of paginate(view, page, PAGE_SIZE)) {
      const li = document.createElement('li');
      li.className = 'flex flex-wrap items-center gap-3 border border-gold/40 p-2';
      const cb = document.createElement('input');
      cb.type = 'checkbox';
      cb.checked = selected.has(i);
      const title = it.title ?? it.control_number ?? t('archive.record.untitled');
      cb.setAttribute('aria-label', t('summon.results.select', { title }));
      cb.addEventListener('change', () => {
        const r = toggleSelection([...selected], i, MAX_BATCH_RECORDS);
        selected = new Set(r.selected);
        cb.checked = selected.has(i);
        setWhy(r.rejected);
        counterEl.textContent = t('summon.results.selected', { n: selected.size, max: MAX_BATCH_RECORDS });
      });
      const name = document.createElement('span');
      name.dir = 'auto';
      name.textContent = title;
      const score = document.createElement('span');
      score.dir = 'ltr';
      score.textContent = t('summon.results.score', { score: it.decay.score });
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'px-3 py-1 border border-gold text-gold';
      btn.textContent = t('summon.results.summon');
      btn.disabled = busy;
      btn.addEventListener('click', () => void run([it.record]));
      li.append(cb, name, score, btn);
      list.appendChild(li);
    }
  }

  function renderOutcome() {
    outcomeList.replaceChildren();
    outcome.hidden = last === null;
    if (!last) return;
    summaryEl.textContent = t('summon.summary', last.summary);
    for (const r of last.results) {
      const li = document.createElement('li');
      if (r.status === 'success') {
        const a = document.createElement('a');
        a.href = `${base}/chamber/?id=${encodeURIComponent(r.id)}`;
        a.className = 'text-gold underline';
        a.dir = 'auto';
        a.textContent = `${t('summon.log.ok', { index: r.index + 1 })} ${t('summon.open')}`;
        li.append(a);
      } else {
        li.className = 'text-decay-red';
        li.textContent = failureText(r.index, r.error.code);
      }
      outcomeList.append(li);
    }
  }

  function setBusy(b: boolean) {
    busy = b;
    chooseBtn.disabled = b;
    syncAuth();
    list.querySelectorAll<HTMLButtonElement>('button').forEach((x) => (x.disabled = b));
    topBtn.disabled = b;
    clearBtn.disabled = b;
  }

  function handleError(e: unknown) {
    const v = summonErrorView(e);
    setError(v);
    if (v.expired) syncAuth();
  }

  async function run(records: RawRecord[], source: ResurrectSource = 'upload') {
    if (busy || records.length === 0) return;
    if (records.length > MAX_BATCH_RECORDS) {
      setError({ key: 'summon.error.too_many' });
      return;
    }
    setError(null);
    last = null;
    renderOutcome();
    setBusy(true);
    setStatus('summon.running');
    appendLine(log, t('summon.log.start', { count: records.length }));
    try {
      const res = await resurrect(records, { source });
      last = res;
      logResults(res);
      if (res.summary.succeeded > 0) showSuccess(log);
      else showFailure(log);
      renderOutcome();
    } catch (e) {
      // 422 BATCH_FAILED carries the per-record results: show them instead of a bare error.
      const failed = batchFailedBody(e);
      if (failed) {
        last = failed;
        logResults(failed);
        renderOutcome();
      }
      showFailure(log);
      handleError(e);
    } finally {
      if (source === 'sample' && tomb && last) {
        // Successes and duplicates are both resurrected now, so neither can be drawn again.
        const used = last.results.filter(
          (r) => r.status === 'success' || r.error.code === 'DUPLICATE_RESURRECTED',
        ).length;
        const remaining = Math.max(0, tomb.remaining - used);
        tomb = { ...tomb, remaining, exhausted: remaining === 0 };
        renderTomb();
      }
      setStatus(null);
      setBusy(false);
    }
  }

  async function onFile(file: File | undefined) {
    if (!file || busy) return;
    setError(null);
    const check = validateUpload(file);
    if (!check.ok) return setError({ key: check.errorKey });
    items = [];
    selected = new Set();
    query = '';
    searchEl.value = '';
    sortMode = 'original';
    page = 1;
    whyShown = false;
    parseErrorCount = 0;
    last = null;
    renderOutcome();
    setBusy(true);
    setStatus('summon.uploading');
    try {
      const res = await uploadMrc(file, file.name);
      items = res.records;
      selected = new Set(items.slice(0, MAX_BATCH_RECORDS).map((_, i) => i));
      parseErrorCount = res.errors.length;
      if (items.length === 0 && parseErrorCount === 0) setError({ key: 'summon.results.none' });
    } catch (e) {
      handleError(e);
    } finally {
      setStatus(null);
      setBusy(false);
      renderItems();
    }
  }

  async function onTomb() {
    if (busy || !isJudge()) return;
    setError(null);
    setBusy(true);
    setStatus('summon.tomb.loading');
    try {
      const res = await getTomb();
      setStatus(null);
      setBusy(false);
      setTomb(res);
      if (res.exhausted || res.records.length === 0) return; // message shown, nothing to send
      await run(res.records.slice(0, MAX_BATCH_RECORDS).map((r) => r.record), 'sample');
    } catch (e) {
      setStatus(null);
      setBusy(false);
      handleError(e);
    }
  }

  chooseBtn.addEventListener('click', () => fileInput.click());
  fileInput.addEventListener('change', () => {
    void onFile(fileInput.files?.[0]);
    fileInput.value = '';
  });
  drop.addEventListener('dragover', (e) => e.preventDefault());
  drop.addEventListener('drop', (e) => {
    e.preventDefault();
    void onFile(e.dataTransfer?.files?.[0]);
  });
  tombBtn.addEventListener('click', () => void onTomb());
  searchEl.addEventListener('input', () => {
    query = searchEl.value;
    page = 1;
    renderItems();
  });
  sortBtn.addEventListener('click', () => {
    sortMode = sortMode === 'original' ? 'decay' : 'original';
    page = 1;
    renderItems();
  });
  prevBtn.addEventListener('click', () => {
    page -= 1;
    renderItems();
  });
  nextBtn.addEventListener('click', () => {
    page += 1;
    renderItems();
  });
  topBtn.addEventListener('click', () => {
    selected = new Set(selectTopDecay(items, MAX_BATCH_RECORDS));
    setWhy(false);
    renderItems();
  });
  clearBtn.addEventListener('click', () => {
    selected = new Set();
    setWhy(false);
    renderItems();
  });
  summonAll.addEventListener('click', () => void run(selectedItems().map((i) => i.record)));
  for (const id of ['up-login', 'up-login2']) {
    const b = $<HTMLButtonElement>(id);
    b.addEventListener('click', () =>
      window.dispatchEvent(new CustomEvent('login:open', { detail: { opener: b } })),
    );
  }

  syncAuth();
  window.addEventListener('auth:changed', syncAuth);
  // api.ts clears the token on 401; show the expired message and lock the controls.
  window.addEventListener('auth:expired', () => {
    setError({ key: 'summon.error.session_expired' });
    syncAuth();
  });
  document.addEventListener('i18n:changed', () => {
    if (errorState) setError(errorState);
    setStatus(statusKey);
    renderItems();
    renderOutcome();
    renderTomb();
  });
</script>
