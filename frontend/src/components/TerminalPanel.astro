---
// Shell only. Fill it with renderRecord/appendLine/showSuccess/showFailure from lib/terminal.ts.
---
<section class="terminal marc-text surface-3 flex flex-col min-w-0 p-0 border border-phosphor/60" dir="ltr" lang="und" data-terminal-panel>
  <h2 class="terminal-header m-0 ps-3 pe-3 pt-2 pb-2 text-xs uppercase tracking-widest text-gold" data-i18n="terminal.title">Raw MARC record</h2>
  <ol
    class="terminal-log list-none m-0 p-3 text-sm min-h-0 grow"
    role="log"
    aria-live="polite"
    aria-relevant="additions"
    data-terminal-log
    data-i18n-attr="aria-label:terminal.title"
    aria-label="Raw MARC record"
  ></ol>
</section>
<style is:global>
  .terminal-header { border-block-end: 1px solid rgba(212, 175, 55, 0.3); font-family: var(--font-label); font-weight: 600; flex: none; }
  .terminal-log { max-block-size: 70vh; overflow-y: auto; color: var(--color-phosphor); }
  .terminal-line { padding-inline-start: 0.5rem; border-inline-start: 3px solid transparent; white-space: pre-wrap; }
  .terminal-decay { color: var(--color-decay-text); border-inline-start-color: var(--color-decay-red); }
  .terminal-decay-label { font-weight: 600; }
  .terminal-failure { color: var(--color-decay-text); }
  .terminal-success { color: var(--color-phosphor); font-weight: 600; }
  .terminal-ai { color: var(--color-ai-violet-text); border: 1px solid var(--color-ai-violet); padding-inline: 0.25rem; font-style: italic; }
  .terminal-line { animation: terminal-in 0.2s ease-out; }
  @keyframes terminal-in { from { opacity: 0; } to { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) {
    .terminal-line { animation: none; }
  }
</style>
