---
---
<div id="login-modal" hidden class="fixed inset-0 z-50 flex items-center justify-center bg-ink/80 p-4">
  <div
    id="login-dialog"
    role="dialog"
    aria-modal="true"
    aria-labelledby="login-title"
    class="w-full max-w-sm border border-gold bg-ink text-parchment p-6">
    <h2 id="login-title" class="text-xl mb-4" data-i18n="login.title">Judge login</h2>
    <form id="login-form" autocomplete="off" novalidate>
      <div class="mb-3">
        <label for="login-username" class="block mb-1" data-i18n="login.username">Username</label>
        <input
          id="login-username"
          name="username"
          type="text"
          autocomplete="off"
          required
          class="w-full border border-gold bg-transparent ps-2 pe-2 py-1" />
      </div>
      <div class="mb-3">
        <label for="login-password" class="block mb-1" data-i18n="login.password">Password</label>
        <input
          id="login-password"
          name="password"
          type="password"
          autocomplete="off"
          required
          class="w-full border border-gold bg-transparent ps-2 pe-2 py-1" />
      </div>
      <p id="login-error" role="alert" hidden class="mb-3 text-decay-red"></p>
      <div class="flex gap-3 justify-end">
        <button
          type="button"
          id="login-cancel"
          class="px-3 py-1 border border-gold text-gold"
          data-i18n="login.cancel">Cancel</button>
        <button
          type="submit"
          id="login-submit"
          class="px-3 py-1 border border-gold text-gold disabled:opacity-50"
          data-i18n="login.submit">Log in</button>
      </div>
    </form>
  </div>
</div>
<script>
  import { login } from '../lib/auth';
  import { handleTrapKey } from '../lib/focusTrap';
  import { t } from '../i18n/i18n';

  const modal = document.getElementById('login-modal') as HTMLElement;
  const dialog = document.getElementById('login-dialog') as HTMLElement;
  const form = document.getElementById('login-form') as HTMLFormElement;
  const user = document.getElementById('login-username') as HTMLInputElement;
  const pass = document.getElementById('login-password') as HTMLInputElement;
  const errEl = document.getElementById('login-error') as HTMLElement;
  const submit = document.getElementById('login-submit') as HTMLButtonElement;
  const cancel = document.getElementById('login-cancel') as HTMLButtonElement;

  let opener: HTMLElement | null = null;
  let timer: ReturnType<typeof setInterval> | null = null;
  let errorKey: string | null = null;
  let busy = false;
  let remaining = 0;
  const inerted: HTMLElement[] = [];

  function showError(key: string | null, params?: Record<string, string | number>) {
    errorKey = key;
    if (key === null) {
      errEl.hidden = true;
      errEl.textContent = '';
      return;
    }
    errEl.textContent = t(key, params);
    errEl.hidden = false;
  }

  function stopCountdown() {
    if (timer !== null) clearInterval(timer);
    timer = null;
    remaining = 0;
  }

  function startCountdown(seconds: number | null) {
    stopCountdown();
    if (seconds === null || !(seconds > 0)) {
      showError('login.rate_limited_unknown');
      return;
    }
    remaining = Math.ceil(seconds);
    submit.disabled = true;
    showError('login.rate_limited', { seconds: remaining });
    timer = setInterval(() => {
      remaining -= 1;
      if (remaining <= 0) {
        stopCountdown();
        submit.disabled = false;
        showError(null);
      } else {
        showError('login.rate_limited', { seconds: remaining });
      }
    }, 1000);
  }

  function isOpen() {
    return !modal.hidden;
  }

  function open(from: HTMLElement | null) {
    if (isOpen()) return;
    opener = from;
    form.reset();
    showError(null);
    submit.disabled = false;
    modal.hidden = false;
    for (const el of Array.from(document.body.children) as HTMLElement[]) {
      if (el !== modal && el.tagName !== 'SCRIPT' && !el.hasAttribute('inert')) {
        el.setAttribute('inert', '');
        inerted.push(el);
      }
    }
    user.focus();
  }

  /** Discards entered values (Req 13.4) and restores focus to the opener. */
  function close() {
    if (!isOpen()) return;
    stopCountdown();
    form.reset();
    user.value = '';
    pass.value = '';
    showError(null);
    modal.hidden = true;
    for (const el of inerted.splice(0)) el.removeAttribute('inert');
    const target = opener;
    opener = null;
    if (target && target.isConnected && !target.hidden) target.focus();
  }

  window.addEventListener('login:open', (e) => {
    const detail = (e as CustomEvent<{ opener?: HTMLElement }>).detail;
    open(detail?.opener ?? null);
  });

  modal.addEventListener('keydown', (e) => {
    handleTrapKey(e, dialog, document.activeElement, close);
  });
  cancel.addEventListener('click', close);

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (busy || timer !== null) return;
    busy = true;
    submit.disabled = true;
    showError(null);
    const result = await login(user.value, pass.value);
    busy = false;
    if (result.ok) {
      close();
      return;
    }
    pass.value = '';
    if (result.kind === 'invalid_credentials') {
      submit.disabled = false;
      showError('login.invalid_credentials');
      pass.focus();
    } else if (result.kind === 'rate_limited') {
      startCountdown(result.retryAfter);
    } else {
      submit.disabled = false;
      showError('login.error');
    }
  });

  // Re-render the visible error in the new language.
  document.addEventListener('i18n:changed', () => {
    if (errorKey !== null) {
      showError(errorKey, errorKey === 'login.rate_limited' ? { seconds: remaining } : undefined);
    }
  });
</script>
