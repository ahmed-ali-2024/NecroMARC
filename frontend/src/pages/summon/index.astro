---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TerminalPanel from '../../components/TerminalPanel.astro';
import Uploader from '../../components/Uploader.astro';
import MarcSources from '../../components/MarcSources.astro';
---
<BaseLayout title="NecroMARC · Summon">
  <main class="ps-4 pe-4 py-6 max-w-6xl mx-auto min-w-0">
    <h1 class="text-3xl mb-4" data-i18n="summon.title">Summon records</h1>
    <div class="grid gap-4 grid-cols-1 md:grid-cols-2 min-w-0">
      <Uploader />
      <TerminalPanel />
    </div>
    <MarcSources />
  </main>
</BaseLayout>
