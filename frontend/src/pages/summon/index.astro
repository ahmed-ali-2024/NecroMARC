---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TerminalPanel from '../../components/TerminalPanel.astro';
import Uploader from '../../components/Uploader.astro';
import MarcSources from '../../components/MarcSources.astro';
---
<BaseLayout title="NecroMARC · Summon">
  <main class="px-margin-mobile md:px-margin py-6 max-w-6xl mx-auto w-full min-w-0">
    <h1 class="font-serif text-3xl text-gold mb-4" data-i18n="summon.title">Summon records</h1>
    <div class="grid gap-gutter grid-cols-1 md:grid-cols-2 min-w-0">
      <Uploader />
      <TerminalPanel />
    </div>
    <MarcSources />
  </main>
</BaseLayout>
