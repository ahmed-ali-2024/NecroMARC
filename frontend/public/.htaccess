# NecroMARC static frontend, deployed to public_html/necromarc/ (LiteSpeed host).
# The api/ subdirectory holds the cPanel Passenger .htaccess and is a separate
# file; never overwrite it when uploading dist/.
#
# This is the configuration verified on the production server. An earlier
# version relied on DirectoryIndex alone and denied dotfiles with
# <FilesMatch "^\."> and a "(^|/)\." rewrite rule; on this LiteSpeed host every
# directory URL (/necromarc/, /necromarc/chamber/) then returned 403 while the
# index.html files themselves were reachable. Directory URLs are therefore
# mapped to index.html explicitly below, and dotfiles are denied by name.

DirectoryIndex index.html
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Leave the Passenger API mount alone.
  RewriteRule ^api(/|$) - [L]

  # HTTP to HTTPS.
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Directories get a trailing slash (every route is a real directory).
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ %{REQUEST_URI}/ [L,R=301]

  # /necromarc/ -> index.html
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^$ index.html [L]

  # /necromarc/<route>/ -> <route>/index.html
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)/$ $1/index.html [L]
</IfModule>

# Deny the files that must never be downloadable, by name.
# .ftp-deploy-sync-state.json is written by the GitHub Actions FTP deploy.
<Files ".ftp-deploy-sync-state.json">
  Require all denied
</Files>
<Files ".htaccess.bak">
  Require all denied
</Files>

<IfModule mod_headers.c>
  # Hashed build assets are immutable.
  <If "%{REQUEST_URI} =~ m#/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  # HTML must always be revalidated.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Security headers.
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"
  Header always set Content-Security-Policy "default-src 'self'; connect-src 'self' https://3aai.in; img-src 'self' data:; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'"
</IfModule>
